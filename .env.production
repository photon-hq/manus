# Database (Dokploy will use internal Docker network)
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/manus_imessage
DB_PASSWORD=${DB_PASSWORD}

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# iMessage Integration
IMESSAGE_SERVER_URL=${IMESSAGE_SERVER_URL}
IMESSAGE_API_KEY=${IMESSAGE_API_KEY}
PHOTON_HANDLE=${PHOTON_HANDLE}

# Manus API
MANUS_API_URL=https://api.manus.im

# LLM Provider
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Admin
ADMIN_PHONES=${ADMIN_PHONES}

# App Config
PORT=3000
NODE_ENV=production
PUBLIC_URL=${PUBLIC_URL}

# Meta Pixel (Facebook Pixel)
META_PIXEL_ID=1275891427925419

# OpenPanel Analytics
OPENPANEL_CLIENT_ID=${OPENPANEL_CLIENT_ID}
OPENPANEL_CLIENT_SECRET=${OPENPANEL_CLIENT_SECRET}
OPENPANEL_API_URL=${OPENPANEL_API_URL}
